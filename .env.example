# Frontend (Vite) — copy to .env.local for local development
# Only VITE_* vars are exposed to the browser.

# Local (API via Vite proxy in vite.config.ts):
VITE_API_URL=/api/v1

# Production (Netlify main) — set in Netlify → Site settings → Environment variables:
# VITE_API_URL=https://staypilotserver-production.up.railway.app/api/v1
#
# Non-main Netlify branch deploys / deploy previews use staging via netlify.toml:
# https://staypilotserver-staging.up.railway.app/api/v1

# Marketing ↔ app domain split (production only).
# In local/dev these fall back to relative paths on the same origin.
# In production builds they fall back to the HostsLedger domains below.
# VITE_APP_URL=https://app.hostsledger.com
# VITE_SITE_URL=https://hostsledger.com
